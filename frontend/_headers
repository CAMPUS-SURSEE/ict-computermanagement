/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'none'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.campus-sursee.ch; font-src 'self'; connect-src 'self' https://graph.microsoft.com https://login.microsoftonline.com; frame-src https://login.microsoftonline.com; base-uri 'none'; form-action 'self' https://login.microsoftonline.com; frame-ancestors 'none'

# Hinweise zur Richtlinie oben. Wird eine dieser Adressen je geändert, muss sie
# auch hier nachgeführt werden, sonst blockiert der Browser den Aufruf
# stillschweigend, und der Fehler ist nur in der Entwicklerkonsole zu sehen.
#
#   script-src 'self'           Der gesamte eigene Code liegt in .js-Dateien.
#                               In den HTML-Seiten steht bewusst kein einziges
#                               inline-Script, deshalb braucht es hier kein
#                               'unsafe-inline'. Wer je ein <script>…</script>
#                               direkt in eine Seite schreibt, muss das hier
#                               aufweichen: besser den Code in eine .js-Datei.
#   script-src cdn.jsdelivr.net Für MSAL, die Anmeldebibliothek von Microsoft.
#                               Sie ist in ALLEN SIEBEN Seiten mit Anmeldung
#                               (index, client, benutzer, telefon, software,
#                               kamera, kamerarolle .html; nicht im Styleguide)
#                               mit derselben Integritätsprüfsumme
#                               (integrity="sha384-…") auf eine feste Fassung
#                               festgenagelt. Wird die Version angehoben, müssen
#                               Adresse und Prüfsumme in allen sieben mit – wer
#                               nur index.html anhebt, bricht die Detailseiten
#                               (code/Pruefe-Frontend.ps1 prüft das).
#                               Dashboard-Style (vendor/dashboard-style/ds.js)
#                               liegt im Repository und fällt unter 'self'.
#   style-src 'unsafe-inline'   Jede Seite trägt im <head> die Zeile
#                               <style>@view-transition { navigation: auto; }</style>
#                               (Seitenübergänge: aus einer Stilvorlage bricht
#                               Chrome sie meist ab), styleguide.html dazu einen
#                               <style>-Block für sein Layout; Skripte setzen
#                               Custom Properties über element.style (Säulen,
#                               Indikator, Meldungen). Für Stile ist das
#                               ungefährlich, für Skripte wäre es das nicht.
#   font-src 'self'             Google Sans und Archivo liegen selbst gehostet
#                               im Repository (vendor/dashboard-style/fonts/,
#                               schriften/; Lizenz SIL OFL 1.1 je daneben).
#                               Google Fonts wird nicht mehr geladen: kein
#                               fonts.googleapis.com, kein fonts.gstatic.com.
#                               Archivo ist nur für die Wortmarke «ICT.INVENTAR».
#   img-src campus-sursee.ch    Nur für das Favicon. Es wird bewusst direkt
#                               von campus-sursee.ch geladen (alle Seiten) und
#                               nicht ins Repository kopiert. (Das Campus-Logo
#                               in der App-Leiste ist der Wortmarke gewichen.)
#   connect-src                 Microsoft Graph liefert die Listendaten,
#                               login.microsoftonline.com die Token.
#                               Seit dem 08.09.2026 steht die Programmliste in
#                               der SharePoint-Liste «Software» statt in einer
#                               Datei. Damit fällt der frühere Eintrag
#                               campussursee.sharepoint.com weg: er war nur
#                               nötig, weil Graph Dateiinhalte nicht selbst
#                               ausliefert, sondern auf download.aspx umleitet.
#                               Listenzeilen kommen direkt von graph.microsoft.com.
#   frame-src login…            MSAL erneuert Token still in einem verborgenen
#                               Rahmen; ohne diesen Eintrag scheitert das.
#   default-src 'none'          Alles Übrige ist verboten. Die Seite lädt
#                               nichts nach, sendet nichts weg und bettet
#                               nichts ein.
